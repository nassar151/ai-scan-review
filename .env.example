# Optional but recommended: the AI agent re-checks every finding in the code (reachability, data flow, new rating, code fix).
# Without a key every scan still works with the built-in (deterministic) ratings and texts.
#
# Provider: groq (GroqCloud, free tier: https://console.groq.com/keys), xai (Grok) or openai.
# If AI_PROVIDER is empty, the provider whose own key is set below is used (GroqCloud by default).
AI_PROVIDER=groq
# Either set AI_API_KEY, or the provider's own variable (GROQ_API_KEY / XAI_API_KEY / OPENAI_API_KEY).
AI_API_KEY=
# Optional overrides. Defaults: groq = openai/gpt-oss-120b, xai = grok-4.7, openai = gpt-4.1-mini.
AI_MODEL=
AI_BASE_URL=
# Agents running in parallel. Defaults: groq 1 (free-tier rate limits), xai 4, openai 6.
AI_CONCURRENCY=
# How long to wait for one AI request.
AI_TIMEOUT_MS=90000

# Optional: raises GitHub API rate limits when reading repository metadata.
GITHUB_TOKEN=

PORT=4000
# The AI service (localhost only). The scan service hands scans to it over HTTP.
AI_PORT=4001
# MongoDB shared by both services. The database and its indexes are created at startup.
MONGODB_URL=mongodb://127.0.0.1:27017/ai_scan_review
# Folder for the cloned repositories (repos/<scanId>), relative to server/.
DATA_DIR=./data
# Repositories larger than this are rejected before cloning.
MAX_REPO_SIZE_MB=500
