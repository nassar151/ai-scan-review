{
  "name": "ai-scan-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n scan,ai,web -c blue,green,magenta \"npm run dev -w server\" \"npm run dev:ai -w server\" \"npm run dev -w web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
