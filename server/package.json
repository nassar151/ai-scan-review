    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^5.1.1"
